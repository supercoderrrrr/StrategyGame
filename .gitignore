# Public portfolio: only reviewed source, documentation and screenshots are tracked.
/*
!/.gitignore
!/.gitattributes
!/.portfolio-export.json
!/README.md
!/DEVELOPMENT.md
!/THIRD_PARTY_NOTICES.md
!/Assets/
!/Packages/
!/ProjectSettings/
!/docs/

/Assets/*
!/Assets/Scripts/
!/Assets/Scripts.meta
!/Assets/Resources/
!/Assets/Resources.meta
!/Assets/PlayerInputActions.cs
!/Assets/PlayerInputActions.cs.meta
!/Assets/PlayerInputActions.inputactions
!/Assets/PlayerInputActions.inputactions.meta

/Assets/Resources/*
!/Assets/Resources/Shaders/
!/Assets/Resources/Shaders.meta

/Packages/*
!/Packages/manifest.json
!/Packages/packages-lock.json

/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt

# Only the six reviewed screenshots are included in the README media gallery.
/docs/media/*
!/docs/media/movement-range.jpg
!/docs/media/fireball-impact.jpg
!/docs/media/tactical-ai.jpg
!/docs/media/fog-before.jpg
!/docs/media/fog-reveal.jpg
!/docs/media/wall-cutout.jpg

**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.keystore
**/*.jks
**/Thumbs.db
**/.DS_Store
**/*.unitypackage
**/*.unitypackage.meta
